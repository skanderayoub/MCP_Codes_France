{
    "pdf_path": "data/input/code_travail.pdf",
    "txt_path": "data/output/code_travail_raw.txt",
    "json_path": "data/output/code_travail.json",
    "cleaning_patterns": [
        "Code du travail\\s*-\\s*Dernière modification le \\d{1,2} \\w+ \\d{4}\\s*-\\s*Document généré le \\d{1,2} \\w+ \\d{4}"
    ],
    "hierarchy_patterns": [
        "(Partie législative ancienne|Partie législative|Partie réglementaire ancienne|Partie réglementaire ancienne|Partie réglementaire - Arrêtés|Partie réglementaire)",
        "(^(?:Première|Deuxième|Troisième|Quatrième|Cinquième|Sixième|Septième|Huitième|Neuvième|Dixième) partie\\s*:.*$)",
        "(^Livre [IVXLCDM]+.*$)",
        "(^Titre [IVXLCDM]+.*$)",
        "(^Chapitre (?:[IVXLCDM]+|préliminaire).*$)",
        "(^Section (?:[IVXLCDM]+|[0-9]+)+.*$)",
        "(^Sous-section\\s+(?:[IVXLCDM]+|[0-9]+).*$)",
        "(^Paragraphe\\s+\\d+(?:\\.\\d+)?\\s*:.*$)"
    ],
    "level_keys": ["partie", "sous-partie", "livre", "titre", "chapitre", "section", "sous_section", "paragraphe"],
    "article_pattern": "(Article\\s+[A-Z]\\*?\\d+(?:-\\d+)*)",
    "content_patterns": [
        "Partie législative ancienne",
        "Partie législative",
        "Partie réglementaire ancienne",
        "Partie réglementaire ancienne",
        "Partie réglementaire - Arrêtés",
        "Partie réglementaire",
        "Première partie",
        "Deuxième partie",
        "Troisième partie",
        "Quatrième partie",
        "Cinquième partie",
        "Sixième partie",
        "Septième partie",
        "Huitième partie",
        "Neuvième partie",
        "Dixième partie",
        "Livre [IVXLCDM]+",
        "Titre [IVXLCDM]+",
        "Chapitre [IVXLCDM]+",
        "Section (?:[IVXLCDM]+|[0-9]+)+",
        "Sous-section\\s+(?:[IVXLCDM]+|[0-9]+)",
        "Paragraphe\\s+\\d+(?:\\.\\d+)?\\s*:.*"
    ],
    "stop_words": ["le", "la", "les", "de", "du", "des", "et", "en", "pour", "par"],
    "llm_config": {
        "model": "llama3.2:1b",
        "temperature": 0.1
    }
}